# `npm run db:setup` creates a PostgreSQL server just for this project and writes this line to
# .env.local (git-ignored) with a generated password. Check it with `npm run db:check`.
# For another server, copy this file to .env.local and fill in its details; URL-encode special
# characters in the password (e.g. @ as %40). On Vercel this becomes the Neon connection string.
DATABASE_URL=postgres://side_notes:CHANGE_ME@localhost:5433/side_notes

# Password of every sample account on this computer; `npm run db:seed` adds a random one.
# Never use it for a database other people can reach.
# DEV_PASSWORD=

# Key that signs login cookies: random, at least 32 bytes, never a made-up phrase; `npm run db:seed` adds a random one on this
# computer. Anywhere else (Vercel) set your own, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# Changing it logs everyone out.
# SESSION_SECRET=
